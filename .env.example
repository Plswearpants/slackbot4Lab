# Slack — from https://api.slack.com/apps
# Keep the app internal / single-workspace: publicly distributed non-Marketplace
# apps are capped at 1 request/min and 15 messages, which breaks backfill.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...          # Socket Mode app-level token

# Channels to index — right-click channel → View channel details → bottom.
# Quote the value. uv's .env parser rejects unquoted values containing spaces,
# so CHANNELS=C1, C2 prints a parse warning on every command; quoting satisfies
# both uv and python-dotenv.
CHANNELS="C0123ABC,C0456DEF"

# Answer model — routed via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
MODEL=anthropic/claude-sonnet-5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Storage
DATA_DIR=./data

# --- retrieval tuning (defaults are fine to start) ---
# CHUNK_GAP_SECONDS=600           # gap that starts a new conversation chunk
# TOP_K=8                         # chunks sent to the model per question
# CANDIDATES_PER_RETRIEVER=30
# RRF_K=60
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# RECONCILE_WINDOW_DAYS=30        # deletion-diff lookback on startup

# --- thread memory ---
# THREAD_TURNS=12                 # prior turns of a thread carried as context

# --- glossary ---
# GLOSSARY_ENABLED=true
# GLOSSARY_UPDATE_HOURS=24        # how often the listener mines for new terms
# GLOSSARY_MAX_NEW_TERMS=5        # cap on terms drafted per pass
# GLOSSARY_MIN_CONVERSATIONS=3    # distinct conversations a term must span
# GLOSSARY_REFRESH_DAYS=7         # age at which a status snapshot is re-derived
# GLOSSARY_MAX_REFRESH=5

# --- Zotero literature filing (optional) ---
# Group library id: the number in zotero.org/groups/<id>/. An API key with
# write access to that group comes from zotero.org/settings/keys.
# ZOTERO_API_KEY=...
# ZOTERO_GROUP_ID=1234567
# Writing to a shared library stays off until switched on deliberately.
# ZOTERO_WRITE_ENABLED=false
# Channels scanned for papers — separate from CHANNELS, which is what the bot
# answers questions about.
# LITERATURE_CHANNELS="C0123ABC"
# LITERATURE_MAX_ITEMS=10
# Unpaywall requires a contact address on every request; it has no API key.
# UNPAYWALL_EMAIL=you@example.edu

# ---------------------------------------------------------------- local models
# The lab cluster, tried first for every answer. Open WebUI speaks the
# OpenAI-compatible protocol, so the base URL is its /api path — the client
# appends /chat/completions itself.
#
# LOCAL_MODEL must be the id the cluster reports, not the model's marketing
# name. List them with:
#   curl -s -H "Authorization: Bearer $LOCAL_API_KEY" \
#        "$LOCAL_API_BASE/models" | jq -r '.data[].id'
#
# Leave these unset to stay on OpenRouter.
LOCAL_API_BASE=
LOCAL_API_KEY=
LOCAL_MODEL=

# Seconds to wait for a local answer before falling back to OpenRouter.
LOCAL_TIMEOUT=90

# Refuse to fall back. Turns "usually local" into a guarantee that channel
# content never leaves the lab — at the cost of no answers when the cluster
# is down.
LOCAL_ONLY=false
